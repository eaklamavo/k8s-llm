# Provider versions are pinned exactly for reproducibility.
# The terraform.lock.hcl file (generated by terraform init) locks the full
# dependency tree including the AVM VNet module's own providers.
# Commit .terraform.lock.hcl to the repo so every machine resolves
# identically without surprises.
#
# To upgrade deliberately:
#   terraform init -upgrade
# then review the diff in .terraform.lock.hcl before committing.

terraform {
  required_version = ">= 1.9, < 2.0"

  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "4.13.0"
    }
    random = {
      source  = "hashicorp/random"
      version = "3.6.3"
    }
    kubernetes = {
      source  = "hashicorp/kubernetes"
      version = "2.35.1"
    }
  }
}
